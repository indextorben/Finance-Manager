<%- include('partials/head') %><%- include('partials/nav') %><h1>CSV-Import</h1><p class="text-secondary">Sicherer Basisimport mit Validierung und Duplikatprüfung. Spalten: date, type, description, gross_amount, optional scope.</p><form method="post" action="/import-csv" enctype="multipart/form-data" class="card card-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control mb-3" type="file" name="csv" accept=".csv,text/csv" required><button class="btn btn-primary align-self-start">Prüfen & importieren</button></form><% if(report){%><div class="alert <%= report.error?'alert-danger':(report.duplicates||report.errors.length)?'alert-warning':'alert-success' %> mt-3"><% if(report.error){%><%= report.error %><%}else{%>Importiert: <%= report.imported %>, Duplikate übersprungen: <%= report.duplicates %>, Fehler: <%= report.errors.length %><%}%></div><%}%><%- include('partials/foot') %>
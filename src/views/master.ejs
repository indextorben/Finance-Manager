<%- include('partials/head') %><%- include('partials/nav') %><div class="d-flex justify-content-between"><div><h1><%= title %></h1><p class="text-secondary">Stammdaten verwalten.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newModal">+ Neu</button></div><div class="row g-3 mt-1"><% rows.forEach(r=>{%><div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><h2 class="h5"><%= r.name %></h2><% const labels={name:'Name',type:'Typ',description:'Beschreibung',opening_balance:'Anfangssaldo',currency:'Währung',kind:'Verwendung',color:'Farbe',icon:'Symbol',company:'Firma',email:'E-Mail',phone:'Telefon',address:'Anschrift',tax_info:'Steuerinformationen',notes:'Notizen'}; const values={income:'Einnahmen',expense:'Ausgaben',both:'Einnahmen und Ausgaben',bank:'Bankkonto',cash:'Bargeld',paypal:'PayPal',credit_card:'Kreditkarte'}; fields.slice(1).forEach(f=>{%><div class="small text-secondary"><%= labels[f]||f %>: <%= values[r[f]]||r[f]||'—' %></div><%})%></div><div class="card-footer bg-transparent"><form method="post" action="/<%= route %>/<%= r.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger"><%= ['accounts','categories','projects'].includes(route)?'Archivieren':'Löschen' %></button></form></div></div></div><%})%></div><div class="modal fade" id="newModal"><div class="modal-dialog"><form method="post" class="modal-content"><div class="modal-header"><h5><%= title %>: neu</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><% fields.forEach(f=>{%><div><label class="form-label"><%= ({name:'Name',type:'Typ',description:'Beschreibung',opening_balance:'Anfangssaldo',currency:'Währung',kind:'Verwendung',color:'Farbe',icon:'Symbol',company:'Firma',email:'E-Mail',phone:'Telefon',address:'Anschrift',tax_info:'Steuerinformationen',notes:'Notizen'})[f]||f %></label><% if(f==='kind'){%><select class="form-select" name="kind"><option value="expense">Ausgabe</option><option value="income">Einnahme</option><option value="both">Beide</option></select><%}else if(f==='type'&&route==='accounts'){%><select class="form-select" name="type"><option>bank</option><option>cash</option><option>paypal</option><option>credit_card</option></select><%}else{%><input class="form-control" name="<%= f %>" <%= f==='name'?'required':'' %>><%}%></div><%})%></div><div class="modal-footer"><button class="btn btn-primary">Speichern</button></div></form></div></div><%- include('partials/foot') %>
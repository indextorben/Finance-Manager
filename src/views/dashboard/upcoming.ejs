<header class="panel-heading"><div><h2>Kommende Zahlungen</h2><p>Bekannte Ausgaben bis Monatsende</p></div><a href="/recurring" class="panel-action" aria-label="Standardbuchungen anzeigen"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></header>
<% if(d.upcoming.length){ %><ul class="upcoming-list"><% d.upcoming.slice(0,4).forEach(p=>{ %><li><a href="<%= p.source==='transaction'?'/transactions?id='+encodeURIComponent(p.id):'/recurring' %>"><time datetime="<%= p.date %>"><%= d.date(p.date,true) %></time><span><strong><%= p.description %></strong><small><%= p.account||'Ohne Konto' %></small></span><strong class="payment-amount">−<%= d.money(p.amount) %></strong></a></li><% }) %></ul><% }else{ %><div class="dashboard-empty compact"><i class="bi bi-calendar2-check" aria-hidden="true"></i><p><%= d.forecast.available?'Keine kommenden Zahlungen.':'Wähle einen Zeitraum bis heute für kommende Zahlungen.' %></p></div><% } %>
<% if(d.forecast.available){ %><div class="upcoming-total"><span>Bis Monatsende erwartet</span><strong>−<%= d.money(d.forecast.expense) %></strong></div><% if(d.forecast.overdue){ %><p class="metric-caption"><%= d.forecast.overdue %> Standardbuchungen haben einen überfälligen Termin und sind nicht in der Prognose enthalten.</p><% } %><% } %><a href="/recurring" class="panel-footer-link">Alle Standardbuchungen anzeigen <span aria-hidden="true">→</span></a>

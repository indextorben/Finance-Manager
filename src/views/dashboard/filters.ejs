<form action="/dashboard" method="get" class="dashboard-filters" id="dashboardFilters" data-validate="off">
  <div class="filter-field"><label for="dashboardPeriod">Zeitraum</label><select name="period" id="dashboardPeriod" class="form-select"><% Object.entries(periods).forEach(([key,label])=>{ %><option value="<%= key %>" <%= dashboard.period.key===key?'selected':'' %>><%= label %></option><% }) %></select></div>
  <div class="filter-field"><label for="dashboardAccount">Konto</label><select name="account" id="dashboardAccount" class="form-select"><option value="">Alle Konten</option><% dashboard.accounts.forEach(a=>{ %><option value="<%= a.id %>" <%= a.id===dashboard.account?'selected':'' %>><%= a.name %><%= a.archived?' (archiviert)':'' %></option><% }) %></select></div>
  <% if(dashboard.currencies.length>1){ %><div class="filter-field filter-currency"><label for="dashboardCurrency">Währung</label><select name="currency" id="dashboardCurrency" class="form-select"><% dashboard.currencies.forEach(code=>{ %><option <%= code===dashboard.currencyCode?'selected':'' %>><%= code %></option><% }) %></select></div><% }else{ %><input type="hidden" name="currency" value="<%= dashboard.currencyCode %>"><% } %>
  <button type="button" id="customizeDashboard" class="btn btn-outline-secondary customize-button" aria-expanded="false" aria-controls="layoutEditor"><i class="bi bi-sliders2" aria-hidden="true"></i><span>Dashboard anpassen</span></button>
  <div id="customPeriod" class="custom-period" <%= dashboard.period.key==='custom'?'':'hidden' %>><div><label for="dashboardStart">Von</label><input class="form-control" type="date" name="start" id="dashboardStart" value="<%= dashboard.period.start %>" max="<%= dashboard.period.today %>"></div><div><label for="dashboardEnd">Bis</label><input class="form-control" type="date" name="end" id="dashboardEnd" value="<%= dashboard.period.end %>" max="<%= dashboard.period.today %>"></div><button class="btn btn-outline-primary" type="submit">Anwenden</button></div>
  <noscript><button class="btn btn-primary">Filter anwenden</button></noscript>
</form>

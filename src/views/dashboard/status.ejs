<header class="panel-heading"><div><h2>Monatsstatus</h2><p><%= new Date(d.period.end+'T12:00:00Z').toLocaleDateString('de-DE',{month:'long',year:'numeric',timeZone:'UTC'}) %><%= d.account?' · gewähltes Konto':'' %></p></div><i class="bi bi-speedometer2" aria-hidden="true"></i></header>
<% if(d.monthlyBudget){ const b=d.monthlyBudget; %><div class="budget-top"><span>Monatsbudget</span><strong class="<%= b.remaining<0?'negative':'' %>"><%= d.percent(b.amount>0?b.spent/b.amount*100:0) %></strong></div><progress class="budget-progress <%= b.remaining<0?'over-budget':'' %>" value="<%= b.progress %>" max="100" aria-label="Verbrauch des Monatsbudgets"><%= b.progress %> %</progress><p class="budget-used"><strong><%= d.money(b.spent) %></strong> von <%= d.money(b.amount) %></p><div class="budget-remaining <%= b.remaining>=0?'positive':'negative' %>"><%= d.money(Math.abs(b.remaining)) %><span><%= b.remaining>=0?'verbleibend':'über Budget' %></span></div><% }else{ %><div class="budget-empty"><span class="empty-symbol"><i class="bi bi-sliders2" aria-hidden="true"></i></span><p><%= d.currencyCode===d.budgetCurrency?'Lege ein Monatsbudget fest, um deine Ausgaben besser zu verfolgen.':'Dein Monatsbudget wird in deiner Profilwährung '+d.budgetCurrency+' geführt. Wechsle die Währung, um es zu verfolgen.' %></p></div><% } %>
<% if(d.categoryBudgets.length){ %><details class="category-budgets"><summary><%= d.categoryBudgets.length %> Kategoriebudgets</summary><% d.categoryBudgets.forEach(b=>{ %><p><strong><%= b.name %></strong><span><%= d.money(b.spent) %> / <%= d.money(b.amount) %></span></p><% }) %></details><% } %>
<% if(d.currencyCode===d.budgetCurrency){ %><details class="budget-setup"><summary><%= d.monthlyBudget?'Budget bearbeiten':'Budget einrichten' %></summary><form method="post" action="/dashboard/budget" class="budget-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="monthlyBudget">Monatsbudget in <%= d.budgetCurrency %></label><div class="input-group"><input id="monthlyBudget" name="amount" class="form-control" data-money data-min-amount="0.01" value="<%= d.monthlyBudget?d.monthlyBudget.amount:'' %>" placeholder="0,00" required><button class="btn btn-primary" type="submit">Speichern</button></div><p class="budget-form-message" role="status"></p></form></details><% } %>

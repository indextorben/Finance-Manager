<header class="panel-heading"><div><h2>Konten</h2><p><%= d.currencyCode %> · Stand <%= d.date(d.period.end,true) %></p></div><a href="/accounts" class="panel-action" aria-label="Konten verwalten"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></header>
<% if(d.accounts.length){ %><ul class="accounts-list"><% d.accounts.forEach(a=>{ %><li><button type="button" data-filter-account="<%= a.id %>" class="<%= a.id===d.account?'selected':'' %>" aria-label="Dashboard auf <%= a.name %> filtern"><span><i class="bi bi-bank" aria-hidden="true"></i><%= a.name %><%= a.archived?' (archiviert)':'' %></span><strong><%= d.money(a.balance) %></strong></button></li><% }) %></ul><div class="upcoming-total"><span>Gesamt in <%= d.currencyCode %></span><strong><%= d.money(d.accounts.reduce((sum,a)=>sum+Number(a.balance),0)) %></strong></div><% }else{ %><div class="dashboard-empty compact"><p>Noch keine Konten in dieser Währung vorhanden.</p><a href="/accounts">Konto anlegen →</a></div><% } %>

<header class="panel-heading"><div><h2>Ausgaben</h2><p>Nach Kategorie · gewählter Zeitraum</p></div><a href="<%= d.link('/expenses') %>" class="panel-action" aria-label="Alle Ausgaben anzeigen"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></header>
<% if(d.categories.length){ %><div class="category-donut"><canvas id="categoryChart" role="img" aria-label="Ausgaben nach Kategorie. Die Beträge und Anteile stehen in der folgenden Liste."></canvas><div class="donut-center"><strong><%= d.money(d.totals.expense) %></strong><span>Gesamtausgaben</span></div></div><ul class="category-list"><% d.categories.forEach(c=>{ %><li><a href="<%= d.link('/expenses',c.other?{}:{category:c.id||'none',status:'paid'}) %>" data-category-name="<%= c.name %>"><span class="legend-dot" style="background:<%= c.color %>"></span><span class="category-name"><%= c.name %></span><strong><%= d.money(c.amount) %></strong><span class="category-share"><%= d.percent(c.share) %></span></a></li><% }) %></ul><% }else{ %><div class="dashboard-empty"><i class="bi bi-pie-chart" aria-hidden="true"></i><p>Keine bezahlten Ausgaben im gewählten Zeitraum.</p><a href="/expenses?new=1">Ausgabe erfassen →</a></div><% } %>

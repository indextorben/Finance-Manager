<article class="net-worth dashboard-panel"><div class="net-worth-heading"><span class="metric-label">Gesamtvermögen</span><span class="metric-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span></div><div class="net-worth-value"><%= d.money(d.balance) %></div>
<% if(d.hasPrevious){ %><div class="wealth-change <%= d.wealthChange>=0?'positive':'negative' %>"><i class="bi bi-arrow-<%= d.wealthChange>=0?'up':'down' %>-right" aria-hidden="true"></i> <%= d.wealthChange>0?'+':'' %><%= d.money(d.wealthChange) %><% if(d.wealthPercent!==null){ %> <span>(<%= d.percent(d.wealthPercent,true) %>)</span><% } %></div><p class="metric-caption">gegenüber dem Vergleichszeitraum</p><% }else{ %><p class="metric-caption">Noch nicht genügend Daten für einen Vergleich.</p><% } %>
<% if(d.hasCurrent){ %><div class="wealth-sparkline"><canvas id="wealthSparkline" role="img" aria-label="Vermögensentwicklung im gewählten Zeitraum"></canvas></div><% } %>
<div class="wealth-details"><div><span>Verfügbar nach Rücklage</span><strong><%= d.money(d.available) %></strong></div><div><a href="/tax">Steuerrücklage · geschätzt <i class="bi bi-info-circle" aria-hidden="true"></i></a><strong><%= d.money(d.reserve) %></strong></div></div><p class="metric-caption net-worth-footnote">Inklusive Anfangssalden · Stand <%= d.date(d.period.end) %></p></article>

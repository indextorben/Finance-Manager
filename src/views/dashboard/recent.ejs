<header class="panel-heading"><div><h2>Letzte Transaktionen</h2><p>Im gewählten Zeitraum</p></div><a href="<%= d.link('/transactions') %>" class="panel-action" aria-label="Alle Transaktionen anzeigen"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></header>
<% if(d.recent.length){ %><ul class="recent-list"><% d.recent.forEach(t=>{ const icon=/^[a-z0-9-]+$/.test(t.category_icon||'')?t.category_icon:t.type==='income'?'arrow-down-left':'credit-card'; %><li><a href="/transactions?id=<%= encodeURIComponent(t.id) %>"><span class="transaction-icon"><i class="bi bi-<%= icon %>" aria-hidden="true"></i></span><span class="transaction-description"><strong><%= t.merchant||t.description %></strong><small><%= t.category||'Ohne Kategorie' %> · <%= t.account||'Ohne Konto' %><%= t.status!=='paid'?' · Offen':'' %></small></span><span class="transaction-amount"><strong class="<%= t.type==='income'?'positive':'negative' %>"><%= t.type==='income'?'+':'−' %><%= d.money(t.gross_amount) %></strong><time datetime="<%= t.date %>"><%= d.date(t.date,true) %></time></span></a></li><% }) %></ul><% }else{ %><div class="dashboard-empty"><i class="bi bi-arrow-left-right" aria-hidden="true"></i><p>Noch keine Transaktionen in diesem Zeitraum vorhanden.</p><a href="/transactions">Transaktionen erfassen →</a></div><% } %><a href="<%= d.link('/transactions') %>" class="panel-footer-link">Alle Transaktionen anzeigen <span aria-hidden="true">→</span></a>

<header class="panel-heading"><div><h2>Cashflow</h2><p><%= d.series.grouping==='monthly'?'Monatlich':d.series.grouping==='weekly'?'Wöchentlich':'Täglich' %> aggregiert · bezahlte Buchungen</p></div></header>
<div class="chart-tabs" role="group" aria-label="Cashflow-Darstellung"><button type="button" class="active" data-chart-tab="flows" aria-pressed="true">Einnahmen &amp; Ausgaben</button><button type="button" data-chart-tab="net" aria-pressed="false">Netto-Cashflow</button><button type="button" data-chart-tab="wealth" aria-pressed="false">Vermögen</button></div>
<div class="chart-summary"><div><span class="legend-dot income-dot"></span><span>Einnahmen</span><strong><%= d.money(d.totals.income) %></strong></div><div><span class="legend-dot expense-dot"></span><span>Ausgaben</span><strong><%= d.money(d.totals.expense) %></strong></div><div><span>Netto</span><strong class="<%= d.cashflow>=0?'positive':'negative' %>"><%= d.cashflow>0?'+':'' %><%= d.money(d.cashflow) %></strong></div></div>
<% if(d.hasCurrent || d.hasPrevious){ %><div class="cashflow-canvas chart-container"><canvas id="cashflowChart" role="img" aria-label="Cashflow: Einnahmen <%= d.money(d.totals.income) %>, Ausgaben <%= d.money(d.totals.expense) %>, Netto <%= d.money(d.cashflow) %>. Einzelwerte stehen in der Datentabelle."></canvas></div><label class="chart-compare"><input type="checkbox" id="compareChart" <%= d.hasPrevious?'checked':'disabled' %>> Vergleichszeitraum <span>(gestrichelt)</span></label><details class="chart-table"><summary>Diagrammdaten anzeigen</summary><div class="table-responsive"><table class="table table-sm"><caption>Bezahlte Buchungen im gewählten Zeitraum</caption><thead><tr><th>Zeitraum</th><th>Einnahmen</th><th>Ausgaben</th><th>Netto</th><th>Vermögen</th></tr></thead><tbody><% d.series.current.forEach(p=>{ %><tr><td><%= d.date(p.start,true) %>–<%= d.date(p.end,true) %></td><td><%= d.money(p.income) %></td><td><%= d.money(p.expense) %></td><td><%= d.money(p.net) %></td><td><%= d.money(p.balance) %></td></tr><% }) %></tbody></table></div></details><% }else{ %><div class="dashboard-empty"><i class="bi bi-bar-chart" aria-hidden="true"></i><p>Noch keine bezahlten Transaktionen in diesen Zeiträumen.</p><a href="/transactions">Erste Transaktion erfassen →</a></div><% } %>

<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-header mb-4">
  <div class="eyebrow">Eingabe prüfen</div>
  <h1><%= title %></h1>
  <p class="text-secondary mb-0">Es wurde nichts gespeichert. <%= errors.length===1?'Die folgende Angabe fehlt oder ist nicht gültig':'Die folgenden Angaben fehlen oder sind nicht gültig' %>.</p>
</div>
<div class="card">
  <ul class="list-group list-group-flush">
    <% errors.forEach(([field,message])=>{ %>
      <li class="list-group-item d-flex gap-3 py-3">
        <i class="bi bi-exclamation-circle-fill text-danger fs-5"></i>
        <div><strong><%= field %></strong><div class="text-secondary small"><%= message %></div></div>
      </li>
    <% }) %>
  </ul>
  <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
    <a class="btn btn-primary" href="<%= back %>"><i class="bi bi-arrow-left me-1"></i>Zurück zum Formular</a>
    <a class="btn btn-outline-secondary" href="/dashboard">Zur Übersicht</a>
  </div>
</div>
<%- include('partials/foot') %>

<%- include('partials/head') %><%- include('partials/nav') %><h1>Belege & Dokumente</h1><p class="text-secondary">PDF/JPG/PNG, geschützt über authentifizierte Auslieferung.</p><form class="card card-body mb-4" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="row g-2"><div class="col-md-5"><input class="form-control" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required></div><div class="col-md-5"><select class="form-select" name="transaction_id"><option value="">Keine Zuordnung</option><% tx.forEach(t=>{%><option value="<%= t.id %>"><%= new Date(t.tx_date).toLocaleDateString('de-DE') %> · <%= t.description %></option><%})%></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Hochladen</button></div></div></form><div class="row g-3"><% rows.forEach(r=>{%><div class="col-md-6"><div class="card"><div class="card-body"><strong><%= r.original_name %></strong><div class="text-secondary small"><%= r.mime_type %> · <%= Math.round(r.size_bytes/1024) %> KB</div><div class="small"><%= r.transaction_description||'Nicht zugeordnet' %></div></div><div class="card-footer bg-transparent d-flex gap-2"><a target="_blank" class="btn btn-sm btn-outline-primary" href="/receipts/<%= r.id %>/file">Öffnen</a><form method="post" action="/receipts/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></div></div></div><%})%></div><%- include('partials/foot') %>
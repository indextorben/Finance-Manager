<%- include('partials/head') %><%- include('partials/nav') %><div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-secondary mb-1">Guten Tag, <%= user.name %></p><h1 class="display-6 fw-bold">Finanzübersicht</h1></div><button id="saveLayout" class="btn btn-outline-secondary"><i class="bi bi-grid-3x3-gap"></i> Layout speichern</button></div><div class="row g-3 mb-4"><% for(const [label,val,cls] of [['Kontostand',k.balance,''],['Einnahmen',k.income,'text-success'],['Ausgaben',k.expense,'text-danger'],['Überschuss',k.surplus,k.surplus>=0?'text-success':'text-danger'],['Rücklage',k.reserve,''],['Offene Forderungen',k.receivables,'']]){%><div class="col-6 col-xl-2"><div class="card kpi h-100"><div class="card-body"><div class="text-secondary small"><%= label %></div><div class="fs-4 fw-bold <%= cls %>"><%= money(val) %> €</div></div></div></div><%}%></div><div class="grid-stack"><div class="grid-stack-item" gs-w="8" gs-h="5" gs-id="finance"><div class="grid-stack-item-content card p-3"><h2 class="h5">Finanzentwicklung</h2><canvas id="financeChart" data-series='<%- JSON.stringify(ts) %>'></canvas></div></div><div class="grid-stack-item" gs-w="4" gs-h="5" gs-id="categories"><div class="grid-stack-item-content card p-3"><h2 class="h5">Ausgaben nach Kategorie</h2><canvas id="categoryChart" data-series='<%- JSON.stringify(cats) %>'></canvas></div></div><div class="grid-stack-item" gs-w="12" gs-h="5" gs-id="recent"><div class="grid-stack-item-content card p-3 overflow-auto"><h2 class="h5">Letzte Transaktionen</h2><table class="table align-middle"><tbody><% recent.forEach(r=>{%><tr><td><%= new Date(r.tx_date).toLocaleDateString('de-DE') %></td><td><strong><%= r.description %></strong><div class="small text-secondary"><%= r.category||'Ohne Kategorie' %> · <%= r.account||'Ohne Konto' %></div></td><td class="text-end fw-semibold <%= r.type==='income'?'text-success':'text-danger' %>"><%= r.type==='income'?'+':'-' %><%= money(r.gross_amount) %> €</td></tr><%})%></tbody></table></div></div></div><%- include('partials/foot') %>
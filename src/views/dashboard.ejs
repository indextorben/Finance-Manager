<%- include('partials/head') %>
<a href="#dashboard" class="dashboard-skip">Zur Finanzübersicht</a>
<%- include('partials/nav') %>
<link rel="stylesheet" href="/css/dashboard.css">
<section class="finance-dashboard" id="dashboard" tabindex="-1" data-csrf="<%= csrf %>" data-user="<%= user.id %>">
  <header class="dashboard-header">
    <div class="dashboard-heading"><p class="greeting">Guten Tag, <%= user.name %></p><h1>Finanzübersicht</h1><p class="dashboard-summary" id="dashboardSummary"><% if(dashboard && dashboard.hasPrevious){ %>Dein Vermögen ist gegenüber dem Vergleichszeitraum um <%= dashboard.money(Math.abs(dashboard.wealthChange)) %> <%= dashboard.wealthChange>=0?'gestiegen':'gesunken' %>.<% }else{ %>Deine Finanzen. Alles im Blick.<% } %></p></div>
    <% if(dashboard){ %><%- include('dashboard/filters',{dashboard,periods}) %><% } %>
  </header>
  <div id="dashboardMessage" class="dashboard-message" role="status" aria-live="polite" hidden></div>
  <% if(dashboardError){ %><div class="dashboard-empty dashboard-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><h2>Übersicht nicht verfügbar</h2><p><%= dashboardError %></p><a href="/dashboard?period=month&account=" class="btn btn-outline-primary">Erneut laden</a></div><% }else{ %>
    <div id="dashboardContent"><%- include('dashboard/content',{dashboard}) %></div>
    <details id="layoutEditor" class="layout-editor"><summary class="visually-hidden">Dashboard anpassen</summary><div class="panel-heading"><div><h2>Dein Dashboard</h2><p>Bereiche einblenden und über die Pfeile sortieren. Am Desktop auch am Griff verschieben.</p></div></div><div id="widgetControls" class="widget-controls"></div><div class="layout-actions"><button type="button" id="saveLayout" class="btn btn-primary">Layout speichern</button><button type="button" id="resetLayout" class="btn btn-outline-secondary">Standard wiederherstellen</button><button type="button" id="closeLayout" class="btn btn-link">Schließen</button></div></details>
    <noscript><p class="dashboard-note">Diagramme und Layout-Anpassungen benötigen JavaScript. Kennzahlen und Filter stehen weiterhin zur Verfügung.</p></noscript>
  <% } %>
</section>
<script src="/js/dashboard.js" defer></script>
<%- include('partials/foot') %>

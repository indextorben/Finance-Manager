<%- include('partials/head') %><%- include('partials/nav') %><div class="d-flex justify-content-between"><div><h1>Rechnungen</h1><p class="text-secondary">Rechnungsstatus und Forderungen verwalten.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#inv">+ Rechnung</button></div><div class="card mt-3"><table class="table mb-0"><thead><tr><th>Nummer</th><th>Kunde</th><th>Datum</th><th>Fällig</th><th>Status</th><th class="text-end">Brutto</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= r.invoice_number %></td><td><%= r.customer||'—' %></td><td><%= new Date(r.invoice_date).toLocaleDateString('de-DE') %></td><td><%= r.due_date?new Date(r.due_date).toLocaleDateString('de-DE'):'—' %></td><td><span class="badge text-bg-secondary"><%= r.status %></span></td><td class="text-end"><%= money(r.gross_amount) %> €</td></tr><%})%></tbody></table></div><div class="modal fade" id="inv"><div class="modal-dialog"><form method="post" class="modal-content"><div class="modal-header"><h5>Rechnung anlegen</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label class="form-label" for="invNumber">Rechnungsnummer</label><input class="form-control" id="invNumber" name="invoice_number" placeholder="z. B. 2026-001" required></div><div><label class="form-label" for="invCustomer">Kunde</label><select class="form-select" id="invCustomer" name="customer_id"><option value="">Ohne Kunde</option><% customers.forEach(c=>{%><option value="<%= c.id %>"><%= c.name %></option><%})%></select></div><div><label class="form-label" for="invDate">Rechnungsdatum</label><input type="date" class="form-control" id="invDate" name="invoice_date" required></div><div><label class="form-label" for="invDue">Fällig am</label><input type="date" class="form-control" id="invDue" name="due_date"></div><div><label class="form-label" for="invNet">Netto</label><div class="input-group"><input class="form-control" id="invNet" name="net_amount" data-money data-min-amount="0" placeholder="0,00" required><span class="input-group-text">€</span></div></div><div><label class="form-label" for="invTax">Steuer</label><div class="input-group"><input class="form-control" id="invTax" name="tax_amount" data-money data-min-amount="0" value="0,00" required><span class="input-group-text">€</span></div></div><div><label class="form-label" for="invStatus">Status</label><select class="form-select" id="invStatus" name="status"><option>draft</option><option>open</option><option>paid</option><option>overdue</option><option>cancelled</option></select></div></div><div class="modal-footer"><button class="btn btn-primary">Speichern</button></div></form></div></div><%- include('partials/foot') %>
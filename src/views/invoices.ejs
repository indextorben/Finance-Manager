<%- include('partials/head') %><%- include('partials/nav') %><div class="d-flex justify-content-between"><div><h1>Rechnungen</h1><p class="text-secondary">Rechnungsstatus und Forderungen verwalten.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#inv">+ Rechnung</button></div><div class="card mt-3"><table class="table mb-0"><thead><tr><th>Nummer</th><th>Kunde</th><th>Datum</th><th>Fällig</th><th>Status</th><th class="text-end">Brutto</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= r.invoice_number %></td><td><%= r.customer||'—' %></td><td><%= new Date(r.invoice_date).toLocaleDateString('de-DE') %></td><td><%= r.due_date?new Date(r.due_date).toLocaleDateString('de-DE'):'—' %></td><td><span class="badge text-bg-secondary"><%= r.status %></span></td><td class="text-end"><%= money(r.gross_amount) %> €</td></tr><%})%></tbody></table></div><div class="modal fade" id="inv"><div class="modal-dialog"><form method="post" class="modal-content"><div class="modal-header"><h5>Rechnung anlegen</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control" name="invoice_number" placeholder="Rechnungsnummer" required><select class="form-select" name="customer_id"><option value="">Kunde</option><% customers.forEach(c=>{%><option value="<%= c.id %>"><%= c.name %></option><%})%></select><input type="date" class="form-control" name="invoice_date" required><input type="date" class="form-control" name="due_date"><input type="number" step="0.01" class="form-control" name="net_amount" placeholder="Netto" required><input type="number" step="0.01" class="form-control" name="tax_amount" placeholder="Steuer" value="0"><select class="form-select" name="status"><option>draft</option><option>open</option><option>paid</option><option>overdue</option><option>cancelled</option></select></div><div class="modal-footer"><button class="btn btn-primary">Speichern</button></div></form></div></div><%- include('partials/foot') %>
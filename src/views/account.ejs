<%- include('partials/head') %>
<%- include('partials/nav') %>
<h1>Mein Konto</h1>
<% if(message){ %><div class="alert alert-success"><%= message %></div><% } %>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row g-4">
  <div class="col-lg-6">
    <form method="post" action="/account/profile" class="card card-body vstack gap-3">
      <h2 class="h5">Profil</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input class="form-control" name="name" value="<%= user.name %>" required>
      <input class="form-control" type="email" name="email" value="<%= user.email %>" required>
      <select class="form-select" name="theme">
        <option value="system">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
      <input class="form-control" name="currency" maxlength="3" value="<%= user.currency %>">
      <button class="btn btn-primary">Profil speichern</button>
    </form>
  </div>
  <div class="col-lg-6">
    <form method="post" action="/account/password" class="card card-body vstack gap-3">
      <h2 class="h5">Passwort ändern</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div>
        <label class="form-label" for="currentPassword">Aktuelles Passwort</label>
        <input id="currentPassword" type="password" class="form-control" name="current_password" autocomplete="current-password" required>
      </div>
      <div>
        <label class="form-label" for="newPassword">Neues Passwort</label>
        <input id="newPassword" type="password" minlength="12" class="form-control" name="password" autocomplete="new-password" required>
        <div class="form-text">Mindestens 12 Zeichen.</div>
      </div>
      <div>
        <label class="form-label" for="confirmPassword">Neues Passwort bestätigen</label>
        <input id="confirmPassword" type="password" minlength="12" class="form-control" name="confirm_password" autocomplete="new-password" required>
      </div>
      <button class="btn btn-primary">Passwort ändern</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>

<%- include('partials/head') %><%- include('partials/nav') %><h1>Steuern</h1><div class="alert alert-info">Vorbereitende Übersicht – keine Steuerberatung. Steuersätze und Behandlung sind vom Benutzer zu prüfen.</div><div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body"><h2 class="h5">Umsatzsteuer / Vorsteuer</h2><table class="table"><thead><tr><th>Monat</th><th>USt.</th><th>Vorsteuer</th><th>Differenz</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= new Date(r.month).toLocaleDateString('de-DE',{month:'long',year:'numeric'}) %></td><td><%= money(r.output_tax) %> €</td><td><%= money(r.input_tax) %> €</td><td><%= money((+r.output_tax||0)-(+r.input_tax||0)) %> €</td></tr><%})%></tbody></table></div></div></div><div class="col-lg-4"><form method="post" action="/tax/settings" class="card card-body"><h2 class="h5">Steuer-Einstellungen</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">Rücklage %</label><input class="form-control mb-2" type="number" step="0.01" min="0" max="100" name="reserve_percent" value="<%= setting?.reserve_percent||30 %>"><label class="form-label">Standard-Steuersatz %</label><input class="form-control mb-3" type="number" step="0.01" name="default_tax_rate" value="<%= setting?.default_tax_rate||19 %>"><button class="btn btn-primary">Speichern</button></form></div></div><%- include('partials/foot') %>
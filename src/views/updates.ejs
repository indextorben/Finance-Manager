<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">Administration</div><h1>Updates</h1><p class="text-secondary mb-0">Automatische Prüfung des GitHub-Repositories.</p></div><form method="post" action="/updates/check"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary"><i class="bi bi-arrow-clockwise me-1"></i>Jetzt prüfen</button></form></div>
<% if(message){ %><div class="alert alert-success"><%= message %></div><% } %>
<% const labels={idle:'Noch nicht geprüft',checking:'Prüfung läuft',current:'Aktuell',available:'Update verfügbar',unknown:'Version unbekannt',error:'Prüfung fehlgeschlagen'}; const alertClasses={current:'success',available:'warning',error:'danger',unknown:'secondary',idle:'secondary',checking:'info'}; %>
<div class="row g-4"><div class="col-lg-7"><div class="card h-100"><div class="card-body p-4"><div class="d-flex align-items-center gap-3 mb-4"><span class="brand-mark"><i class="bi bi-cloud-arrow-down"></i></span><div><div class="text-secondary small">Status</div><div class="fs-4 fw-bold text-<%= alertClasses[update.status]||'secondary' %>"><%= labels[update.status]||update.status %></div></div></div>
<% if(update.error){ %><div class="alert alert-danger"><%= update.error %></div><% } %>
<dl class="row mb-0"><dt class="col-sm-5">Repository</dt><dd class="col-sm-7"><a href="https://github.com/<%= update.repo %>" target="_blank" rel="noopener"><%= update.repo %></a></dd><dt class="col-sm-5">Branch</dt><dd class="col-sm-7"><code><%= update.branch %></code></dd><dt class="col-sm-5">Installierter Commit</dt><dd class="col-sm-7"><code><%= update.currentCommit?.slice(0,12)||'Nicht im Build hinterlegt' %></code></dd><dt class="col-sm-5">Neuester Commit</dt><dd class="col-sm-7"><% if(update.latestUrl){ %><a href="<%= update.latestUrl %>" target="_blank" rel="noopener"><code><%= update.latestCommit?.slice(0,12) %></code></a><% }else{ %>—<% } %></dd><dt class="col-sm-5">Letzte Prüfung</dt><dd class="col-sm-7"><%= update.checkedAt?new Date(update.checkedAt).toLocaleString('de-DE'):'Noch nicht geprüft' %></dd><% if(update.latestMessage){ %><dt class="col-sm-5">Letzte Änderung</dt><dd class="col-sm-7"><%= update.latestMessage %></dd><% } %></dl>
</div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-body p-4"><h2 class="h5"><i class="bi bi-shield-check me-2"></i>Sicher aktualisieren</h2><p class="text-secondary">Die App prüft automatisch, installiert Updates aber nicht unbeaufsichtigt. So werden lokale Änderungen und laufende Container nicht beschädigt.</p><p class="mb-2">Im Projektordner ausführen:</p><pre class="bg-body-tertiary border rounded-3 p-3 mb-0"><code>git pull --ff-only origin <%= update.branch %>
docker compose up -d --build</code></pre></div></div></div></div>
<%- include('partials/foot') %>

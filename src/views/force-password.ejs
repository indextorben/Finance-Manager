<%- include('partials/head') %><div class="auth-page single"><section class="auth-form-side"><div class="auth-card-modern"><div class="brand-mark big mb-4"><i class="bi bi-key"></i></div><span class="eyebrow">Erster Login</span><h2>Initialpasswort ändern</h2><p class="text-secondary mb-4">Bevor du Finance Manager verwenden kannst, musst du ein eigenes Passwort festlegen.</p><% if(error){%><div class="alert alert-danger"><%= error %></div><%}%><form method="post" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label class="form-label">Neues Passwort</label><input class="form-control form-control-lg" type="password" name="password" minlength="12" autocomplete="new-password" required><div class="form-text">Mindestens 12 Zeichen.</div></div><div><label class="form-label">Passwort wiederholen</label><input class="form-control form-control-lg" type="password" name="confirm" minlength="12" autocomplete="new-password" required></div><button class="btn btn-primary btn-lg">Passwort speichern und fortfahren</button></form></div></section></div><%- include('partials/foot-auth') %>

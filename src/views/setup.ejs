<%- include('partials/head') %><div class="auth-shell"><div class="auth-card"><h1 class="h3 fw-bold">Finance Manager einrichten</h1><p class="text-secondary">Der erste Benutzer wird Administrator.</p><% if(error){%><div class="alert alert-danger"><%= error %></div><%}%><form method="post" class="vstack gap-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control" name="name" placeholder="Name" required><input class="form-control" name="username" placeholder="Benutzername" required><input class="form-control" type="email" name="email" placeholder="E-Mail" required><input class="form-control" type="password" name="password" minlength="12" placeholder="Passwort (mind. 12 Zeichen)" required><button class="btn btn-primary">Administrator erstellen</button></form></div></div><%- include('partials/foot') %>
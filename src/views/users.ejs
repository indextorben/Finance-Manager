<%- include('partials/head') %><%- include('partials/nav') %><div class="d-flex justify-content-between"><h1>Benutzerverwaltung</h1><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#usr">+ Benutzer</button></div><div class="card mt-3"><table class="table mb-0"><thead><tr><th>Name</th><th>Login</th><th>Rolle</th><th>Status</th><th></th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= r.name %><div class="small text-secondary"><%= r.email %></div></td><td><%= r.username %></td><td><%= r.role %></td><td><%= r.active?'Aktiv':'Deaktiviert' %></td><td><form method="post" action="/users/<%= r.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-secondary">Status ändern</button></form></td></tr><%})%></tbody></table></div><div class="modal fade" id="usr"><div class="modal-dialog"><form method="post" class="modal-content"><div class="modal-header"><h5>Benutzer erstellen</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body vstack gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control" name="name" placeholder="Name" required><input class="form-control" name="username" placeholder="Benutzername" required><input class="form-control" type="email" name="email" placeholder="E-Mail" required><input class="form-control" type="password" minlength="12" name="password" placeholder="Initialpasswort" required><select class="form-select" name="role"><option>USER</option><option>ADMIN</option></select></div><div class="modal-footer"><button class="btn btn-primary">Erstellen</button></div></form></div></div><%- include('partials/foot') %>
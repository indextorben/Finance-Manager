<%- include('partials/head') %><%- include('partials/nav') %><div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">Finanzen</div><h1><%= section==='income'?'Einnahmen':section==='expense'?'Ausgaben':'Transaktionen' %></h1><p class="text-secondary mb-0"><%= section==='income'?'Alle Einnahmen erfassen und verwalten.':section==='expense'?'Alle Ausgaben erfassen und verwalten.':'Einnahmen und Ausgaben zentral verwalten.' %></p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#txModal"><i class="bi bi-plus-lg me-1"></i><%= section==='income'?'Einnahme hinzufügen':section==='expense'?'Ausgabe hinzufügen':'Transaktion hinzufügen' %></button></div><form class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><input class="form-control" name="q" value="<%= filter.q||'' %>" placeholder="Suchen…"></div><% if(section==='all'){ %><div class="col"><select class="form-select" name="type"><option value="">Alle Typen</option><option value="income" <%= filter.type==='income'?'selected':'' %>>Einnahme</option><option value="expense" <%= filter.type==='expense'?'selected':'' %>>Ausgabe</option></select></div><% } else { %><input type="hidden" name="type" value="<%= section %>"><input type="hidden" name="view" value="<%= section %>"><% } %><div class="col"><select class="form-select" name="scope"><option value="">Privat + Geschäftlich</option><option value="private">Privat</option><option value="business">Geschäftlich</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Filtern</button></div><div class="col-auto"><a class="btn btn-outline-secondary" href="<%= section==='income'?'/income':section==='expense'?'/expenses':'/transactions' %>">Zurücksetzen</a></div></div></form><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Datum</th><th>Typ</th><th>Beschreibung</th><th>Kategorie</th><th>Konto</th><th class="text-end">Betrag</th><th>Status</th><th></th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= new Date(r.tx_date).toLocaleDateString('de-DE') %></td><td><span class="badge text-bg-<%= r.type==='income'?'success':'danger' %>"><%= r.type==='income'?'Einnahme':'Ausgabe' %></span></td><td><strong><%= r.description %></strong><div class="small text-secondary"><%= r.scope==='business'?'Geschäftlich':'Privat' %></div></td><td><%= r.category||'—' %></td><td><%= r.account||'—' %></td><td class="text-end fw-bold"><%= money(r.gross_amount) %> €</td><td><%= ({paid:'Bezahlt',open:'Offen',overdue:'Überfällig',draft:'Entwurf',cancelled:'Storniert'})[r.status]||r.status %></td><td><form method="post" action="/transactions/<%= r.id %>/delete" onsubmit="return confirm('Transaktion archivieren?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" title="Archivieren"><i class="bi bi-archive"></i></button></form></td></tr><%})%><% if(!rows.length){%><tr><td colspan="8" class="text-center py-5 text-secondary">Noch keine Transaktionen vorhanden.</td></tr><%}%></tbody></table></div></div><div class="mt-3 d-flex gap-2"><a class="btn btn-outline-secondary" href="/export/csv">CSV</a><a class="btn btn-outline-secondary" href="/export/xlsx">XLSX</a><a class="btn btn-outline-secondary" href="/export/pdf">PDF</a></div><div class="modal fade" id="txModal"><div class="modal-dialog modal-lg"><form method="post" action="/transactions" class="modal-content"><div class="modal-header"><h5>Transaktion erfassen</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="row g-3"><div class="col-md-4"><label class="form-label">Typ</label><select name="type" class="form-select" <%= section!=='all'?'disabled':'' %>><option value="expense" <%= section==='expense'?'selected':'' %>>Ausgabe</option><option value="income" <%= section==='income'?'selected':'' %>>Einnahme</option></select><% if(section!=='all'){%><input type="hidden" name="type" value="<%= section %>"><input type="hidden" name="return_to" value="<%= section %>"><%}%></div><div class="col-md-4"><label>Datum</label><input type="date" name="tx_date" class="form-control" required></div><div class="col-md-4"><label>Bereich</label><select name="scope" class="form-select"><option value="private">Privat</option><option value="business">Geschäftlich</option></select></div><div class="col-12"><label>Beschreibung</label><input name="description" class="form-control" required></div><div class="col-md-4"><label>Netto</label><input name="net_amount" type="number" step="0.01" min="0" class="form-control" required></div><div class="col-md-4"><label>Steuer</label><input name="tax_amount" type="number" step="0.01" min="0" value="0" class="form-control"></div><div class="col-md-4"><label>Status</label><select name="status" class="form-select"><option value="paid">Bezahlt</option><option value="open">Offen</option><option value="overdue">Überfällig</option></select></div><div class="col-md-6"><label>Konto</label><select name="account_id" class="form-select"><option value="">—</option><% accounts.forEach(x=>{%><option value="<%= x.id %>"><%= x.name %></option><%})%></select></div><div class="col-md-6"><label>Kategorie</label><select name="category_id" class="form-select"><option value="">—</option><% categories.forEach(x=>{%><option value="<%= x.id %>"><%= x.name %></option><%})%></select></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="tax_relevant" id="taxRel"><label class="form-check-label" for="taxRel">Steuerlich relevant</label></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Speichern</button></div></form></div></div><%- include('partials/foot') %>
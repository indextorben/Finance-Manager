<%- include('partials/head') %>
<%- include('partials/nav') %>
<%
  const basePath = section==='income'?'/income':section==='expense'?'/expenses':'/transactions';
  const linkWith = changes => {
    const p = new URLSearchParams();
    for(const [k,v] of Object.entries(filter||{})) if(k!=='page'&&v) p.set(k,v);
    for(const [k,v] of Object.entries(changes)) { if(v===null||v==='') p.delete(k); else p.set(k,v); }
    const qs = p.toString();
    return basePath+(qs?'?'+qs:'');
  };
  const sortLink = dir => linkWith({sort:dir, page:null});
  const pageLink = n => linkWith({sort, page:n});
  const monthNames = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  const monthLabel = m => monthNames[+m.slice(5,7)-1]+' '+m.slice(0,4);
  const first = total ? offset+1 : 0;
  const last = offset + rows.length;
%>

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <div class="eyebrow">Finanzen</div>
    <h1><%= section==='income'?'Einnahmen':section==='expense'?'Ausgaben':'Transaktionen' %></h1>
    <p class="text-secondary mb-0"><%= section==='income'?'Alle Einnahmen erfassen und verwalten.':section==='expense'?'Alle Ausgaben erfassen und verwalten.':'Einnahmen und Ausgaben zentral verwalten.' %></p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#txModal"><i class="bi bi-plus-lg me-1"></i><%= section==='income'?'Einnahme hinzufügen':section==='expense'?'Ausgabe hinzufügen':'Transaktion hinzufügen' %></button>
</div>

<% if(dupInfo.groups){ %>
  <div class="alert alert-warning d-flex flex-wrap align-items-center gap-3 mb-3">
    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
    <div class="flex-grow-1">
      <strong><%= dupInfo.items %> <%= section==='income'?'Einnahmen':section==='expense'?'Ausgaben':'Transaktionen' %> sehen wie Duplikate aus</strong>
      <div class="small"><%= dupInfo.groups===1?'Ein Eintrag kommt':dupInfo.groups+' Einträge kommen' %> mehrfach mit gleichem Datum, gleicher Beschreibung und gleichem Betrag vor.</div>
    </div>
    <% if(filter.duplicates==='1'){ %>
      <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>">Alle anzeigen</a>
    <% } else { %>
      <a class="btn btn-sm btn-warning" href="<%= basePath %>?duplicates=1">Duplikate anzeigen</a>
    <% } %>
  </div>
<% } %>

<form class="card card-body mb-3">
  <div class="row g-2">
    <input type="hidden" name="sort" value="<%= sort %>">
    <% if(filter.duplicates==='1'){ %><input type="hidden" name="duplicates" value="1"><% } %>
    <div class="col-md-4"><input class="form-control" name="q" value="<%= filter.q||'' %>" placeholder="Suchen…"></div>
    <% if(section==='all'){ %>
      <div class="col"><select class="form-select" name="type"><option value="">Alle Typen</option><option value="income" <%= filter.type==='income'?'selected':'' %>>Einnahme</option><option value="expense" <%= filter.type==='expense'?'selected':'' %>>Ausgabe</option></select></div>
    <% } else { %>
      <input type="hidden" name="type" value="<%= section %>"><input type="hidden" name="view" value="<%= section %>">
    <% } %>
    <div class="col"><select class="form-select" name="scope"><option value="">Privat + Geschäftlich</option><option value="private" <%= filter.scope==='private'?'selected':'' %>>Privat</option><option value="business" <%= filter.scope==='business'?'selected':'' %>>Geschäftlich</option></select></div>
    <div class="col"><select class="form-select" name="month" aria-label="Monat"><option value="">Alle Monate</option><% months.forEach(m=>{ %><option value="<%= m.m %>" <%= month===m.m?'selected':'' %>><%= monthLabel(m.m) %> (<%= m.n %>)</option><% }) %></select></div>
    <div class="col"><select class="form-select" name="per" aria-label="Einträge pro Seite"><option value="25" <%= per==='25'?'selected':'' %>>25 pro Seite</option><option value="50" <%= per==='50'?'selected':'' %>>50 pro Seite</option><option value="100" <%= per==='100'?'selected':'' %>>100 pro Seite</option><option value="all" <%= per==='all'?'selected':'' %>>Alle anzeigen</option></select></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Filtern</button></div>
    <div class="col-auto"><a class="btn btn-outline-secondary" href="<%= basePath %>">Zurücksetzen</a></div>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th><a class="text-decoration-none text-reset d-inline-flex align-items-center gap-1" href="<%= sortLink(sort==='asc'?'desc':'asc') %>" title="<%= sort==='asc'?'Neueste zuerst':'Älteste zuerst' %>" aria-label="Nach Datum sortieren – <%= sort==='asc'?'neueste zuerst':'älteste zuerst' %>">Datum <i class="bi bi-caret-<%= sort==='asc'?'up':'down' %>-fill small"></i></a></th><th>Typ</th><th>Beschreibung</th><th>Kategorie</th><th>Konto</th><th class="text-end">Betrag</th><th>Status</th><th><span class="visually-hidden">Aktionen</span></th></tr></thead>
      <tbody>
        <% rows.forEach(r=>{ %>
          <tr>
            <td><%= new Date(r.tx_date).toLocaleDateString('de-DE') %></td>
            <td><span class="badge text-bg-<%= r.type==='income'?'success':'danger' %>"><%= r.type==='income'?'Einnahme':'Ausgabe' %></span></td>
            <td><strong><%= r.description %></strong><% if(dupKeys.has(dupKey(r))){ %> <span class="badge text-bg-warning" title="Gleiches Datum, gleiche Beschreibung und gleicher Betrag wie ein anderer Eintrag"><i class="bi bi-exclamation-triangle-fill me-1"></i>Mögliches Duplikat</span><% } %><div class="small text-secondary"><%= r.scope==='business'?'Geschäftlich':'Privat' %></div></td>
            <td><%= r.category||'—' %></td>
            <td><%= r.account||'—' %></td>
            <td class="text-end fw-bold"><%= money(r.gross_amount) %> €</td>
            <td><%= ({paid:'Bezahlt',open:'Offen',overdue:'Überfällig',draft:'Entwurf',cancelled:'Storniert'})[r.status]||r.status %></td>
            <td>
              <div class="d-flex justify-content-end gap-1">
                <button type="button" class="btn btn-sm btn-outline-primary edit-transaction" title="Bearbeiten" aria-label="<%= r.description %> bearbeiten" data-bs-toggle="modal" data-bs-target="#editTxModal" data-id="<%= r.id %>" data-type="<%= r.type %>" data-date="<%= r.tx_date_input %>" data-description="<%= r.description %>" data-net="<%= r.net_amount %>" data-tax="<%= r.tax_amount %>" data-scope="<%= r.scope %>" data-status="<%= r.status %>" data-account="<%= r.account_id||'' %>" data-account-name="<%= r.account||'' %>" data-category="<%= r.category_id||'' %>" data-category-name="<%= r.category||'' %>" data-tax-relevant="<%= r.tax_relevant?'true':'false' %>"><i class="bi bi-pencil"></i></button>
                <form method="post" action="/transactions/<%= r.id %>/delete" onsubmit="return confirm('Transaktion archivieren?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" title="Archivieren"><i class="bi bi-archive"></i></button></form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if(!rows.length){ %><tr><td colspan="8" class="text-center py-5 text-secondary"><%= filter.duplicates==='1'?'Keine möglichen Duplikate gefunden.':(month?'Keine Transaktionen im '+monthLabel(month)+'.':(filter.q||filter.type||filter.scope?'Keine Transaktionen passen zu diesem Filter.':'Noch keine Transaktionen vorhanden.')) %></td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<% if(total){ %>
  <div class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="text-secondary small"><%= first %>–<%= last %> von <%= total %> <%= total===1?'Eintrag':'Einträgen' %><%= month?' im '+monthLabel(month):'' %></div>
    <% if(pages>1){ %>
      <nav aria-label="Seiten">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="<%= pageLink(page-1) %>" <%= page<=1?'tabindex="-1" aria-disabled="true"':'' %>>Zurück</a></li>
          <% const from=Math.max(1,Math.min(page-2,pages-4)), to=Math.min(pages,from+4); %>
          <% if(from>1){ %><li class="page-item"><a class="page-link" href="<%= pageLink(1) %>">1</a></li><% if(from>2){ %><li class="page-item disabled"><span class="page-link">…</span></li><% } %><% } %>
          <% for(let n=from;n<=to;n++){ %><li class="page-item <%= n===page?'active':'' %>"><a class="page-link" href="<%= pageLink(n) %>" <%= n===page?'aria-current="page"':'' %>><%= n %></a></li><% } %>
          <% if(to<pages){ %><% if(to<pages-1){ %><li class="page-item disabled"><span class="page-link">…</span></li><% } %><li class="page-item"><a class="page-link" href="<%= pageLink(pages) %>"><%= pages %></a></li><% } %>
          <li class="page-item <%= page>=pages?'disabled':'' %>"><a class="page-link" href="<%= pageLink(page+1) %>" <%= page>=pages?'tabindex="-1" aria-disabled="true"':'' %>>Weiter</a></li>
        </ul>
      </nav>
      <a class="btn btn-sm btn-outline-secondary" href="<%= linkWith({sort, per:'all', page:null}) %>">Alle <%= total %> auf einer Seite</a>
    <% } %>
  </div>
<% } %>

<div class="mt-3 d-flex gap-2"><a class="btn btn-outline-secondary" href="/export/csv">CSV</a><a class="btn btn-outline-secondary" href="/export/xlsx">XLSX</a><a class="btn btn-outline-secondary" href="/export/pdf">PDF</a></div>

<div class="modal fade" id="editTxModal" tabindex="-1" aria-labelledby="editTxTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form method="post" class="modal-content" id="editTxForm">
      <div class="modal-header"><h5 class="modal-title" id="editTxTitle">Transaktion bearbeiten</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button></div>
      <div class="modal-body">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="type" id="editType">
        <input type="hidden" name="return_to" value="<%= section %>">
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label" for="editTypeDisplay">Typ</label><select class="form-select" id="editTypeDisplay" disabled><option value="expense">Ausgabe</option><option value="income">Einnahme</option></select></div>
          <div class="col-md-4"><label class="form-label" for="editDate">Datum</label><input type="date" name="tx_date" id="editDate" class="form-control" required></div>
          <div class="col-md-4"><label class="form-label" for="editScope">Bereich</label><select name="scope" id="editScope" class="form-select"><option value="private">Privat</option><option value="business">Geschäftlich</option></select></div>
          <div class="col-12"><label class="form-label" for="editDescription">Beschreibung</label><input name="description" id="editDescription" class="form-control" list="descriptionSuggestions" autocomplete="off" maxlength="200" required><div class="form-text">Bereits genutzte Beschreibungen werden vorgeschlagen – die Kategorie der letzten Buchung wird dabei übernommen.</div></div>
          <div class="col-md-4"><label class="form-label" for="editNet">Netto</label><div class="input-group"><input name="net_amount" id="editNet" class="form-control" data-money data-min-amount="0" required><span class="input-group-text">€</span></div></div>
          <div class="col-md-4"><label class="form-label" for="editTax">Steuer</label><div class="input-group"><input name="tax_amount" id="editTax" class="form-control" data-money data-min-amount="0" required><span class="input-group-text">€</span></div></div>
          <div class="col-md-4"><label class="form-label" for="editStatus">Status</label><select name="status" id="editStatus" class="form-select"><option value="paid">Bezahlt</option><option value="open">Offen</option><option value="overdue">Überfällig</option><option value="draft">Entwurf</option><option value="cancelled">Storniert</option></select></div>
          <div class="col-md-6"><label class="form-label" for="editAccount">Konto</label><select name="account_id" id="editAccount" class="form-select" data-main-account="<%= mainAccountId %>" <%= accounts.length?'required':'' %>><option value="" <%= accounts.length?'disabled':'' %>><%= accounts.length?'Bitte auswählen':'—' %></option><% accounts.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select><% if(!accounts.length){ %><div class="form-text">Noch kein Konto vorhanden – <a href="/accounts">zuerst ein Konto anlegen</a>.</div><% } %></div>
          <div class="col-md-6"><%- include('partials/category-select',{categories,id:'editCategory'}) %></div>
          <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="tax_relevant" id="editTaxRelevant"><label class="form-check-label" for="editTaxRelevant">Steuerlich relevant</label></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Änderungen speichern</button></div>
    </form>
  </div>
</div>

<div class="modal fade" id="txModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form method="post" action="/transactions" class="modal-content">
      <div class="modal-header"><h5>Transaktion erfassen</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button></div>
      <div class="modal-body">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">Typ</label><select name="type" class="form-select" <%= section!=='all'?'disabled':'' %>><option value="expense" <%= section==='expense'?'selected':'' %>>Ausgabe</option><option value="income" <%= section==='income'?'selected':'' %>>Einnahme</option></select><% if(section!=='all'){ %><input type="hidden" name="type" value="<%= section %>"><input type="hidden" name="return_to" value="<%= section %>"><% } %></div>
          <div class="col-md-4"><label class="form-label">Datum</label><input type="date" name="tx_date" class="form-control" required></div>
          <div class="col-md-4"><label class="form-label">Bereich</label><select name="scope" class="form-select"><option value="private">Privat</option><option value="business">Geschäftlich</option></select></div>
          <div class="col-12"><label class="form-label" for="newDescription">Beschreibung</label><input name="description" id="newDescription" class="form-control" list="descriptionSuggestions" autocomplete="off" placeholder="z. B. Wocheneinkauf" maxlength="200" required><div class="form-text">Bereits genutzte Beschreibungen werden vorgeschlagen – die Kategorie der letzten Buchung wird dabei übernommen.</div></div>
          <div class="col-md-4"><label class="form-label" for="newNet">Netto</label><div class="input-group"><input name="net_amount" id="newNet" class="form-control" data-money data-min-amount="0" placeholder="0,00" required><span class="input-group-text">€</span></div><div class="form-text">Tausenderpunkte werden automatisch gesetzt – für Cent einfach Komma tippen.</div></div>
          <div class="col-md-4"><label class="form-label" for="newTax">Steuer</label><div class="input-group"><input name="tax_amount" id="newTax" class="form-control" data-money data-min-amount="0" value="0,00" required><span class="input-group-text">€</span></div></div>
          <div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="paid">Bezahlt</option><option value="open">Offen</option><option value="overdue">Überfällig</option></select></div>
          <div class="col-md-6"><label class="form-label" for="newAccount">Konto</label><select name="account_id" id="newAccount" class="form-select" <%= accounts.length?'required':'' %>><option value="" <%= accounts.length?'disabled':'' %> <%= mainAccountId?'':'selected' %>><%= accounts.length?'Bitte auswählen':'—' %></option><% accounts.forEach(x=>{ %><option value="<%= x.id %>" <%= x.id===mainAccountId?'selected':'' %>><%= x.name %></option><% }) %></select><% if(accounts.length>1&&mainAccountId){ %><div class="form-text">Vorbelegt mit „<%= accounts.find(x=>x.id===mainAccountId).name %>“ – bei Bedarf einfach umstellen.</div><% } %><% if(!accounts.length){ %><div class="form-text">Noch kein Konto vorhanden – <a href="/accounts">zuerst ein Konto anlegen</a>.</div><% } %></div>
          <div class="col-md-6"><%- include('partials/category-select',{categories,id:'newCategory'}) %></div>
          <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="tax_relevant" id="taxRel"><label class="form-check-label" for="taxRel">Steuerlich relevant</label></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Speichern</button></div>
    </form>
  </div>
</div>

<%- include('partials/description-suggestions') %>
<script src="/js/category-field.js"></script>
<script src="/js/description-category.js"></script>
<script src="/js/transactions.js"></script>
<%- include('partials/foot') %>

<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">Organisation</div><h1 class="mb-1">Konten</h1><p class="text-secondary mb-0">Bankkonten, Kreditkarten, PayPal und Bargeld mit Anfangssaldo verwalten.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#accountModal"><i class="bi bi-plus-lg me-1"></i>Konto hinzufügen</button></div>
<div class="row g-3"><% rows.forEach(a=>{ const labels={bank:'Bankkonto',cash:'Bargeld',paypal:'PayPal',credit_card:'Kreditkarte',savings:'Rücklagenkonto',clearing:'Verrechnungskonto'}; %><div class="col-md-6 col-xl-4"><div class="card account-card h-100 <%= a.archived?'opacity-50':'' %>"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div class="account-icon"><i class="bi <%= a.type==='cash'?'bi-cash-stack':a.type==='credit_card'?'bi-credit-card':a.type==='paypal'?'bi-wallet2':'bi-bank' %>"></i></div><span class="badge rounded-pill text-bg-light"><%= labels[a.type]||a.type %></span></div><h2 class="h5 mt-3 mb-1"><%= a.name %></h2><div class="text-secondary small"><%= a.description||'Keine Beschreibung' %></div><div class="mt-4"><div class="small text-secondary">Aktueller Saldo</div><div class="fs-3 fw-bold"><%= money(a.current_balance) %> <%= a.currency %></div></div><div class="d-flex justify-content-between mt-3 small"><span class="text-secondary">Anfangssaldo</span><strong><%= money(a.opening_balance) %> <%= a.currency %></strong></div></div><% if(!a.archived){%><div class="card-footer bg-transparent border-0 pt-0"><form method="post" action="/accounts/<%= a.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-secondary"><i class="bi bi-archive me-1"></i>Archivieren</button></form></div><%}%></div></div><%})%><% if(!rows.length){%><div class="col-12"><div class="card empty-state"><div class="card-body text-center py-5"><i class="bi bi-bank fs-1"></i><h2 class="h5 mt-3">Noch kein Konto vorhanden</h2><p class="text-secondary">Lege dein erstes Konto mit dem tatsächlichen Anfangssaldo an.</p><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#accountModal">Erstes Konto hinzufügen</button></div></div></div><%}%></div>
<div class="modal fade" id="accountModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form method="post" action="/accounts" class="modal-content"><div class="modal-header"><div><h5 class="modal-title">Konto hinzufügen</h5><div class="small text-secondary">Der Anfangssaldo bildet dein Startkapital bzw. den aktuellen Stand zum Start der Erfassung ab.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="row g-3"><div class="col-md-7"><label class="form-label">Kontoname</label><input class="form-control" name="name" placeholder="z. B. Geschäftskonto" required></div><div class="col-md-5"><label class="form-label">Kontotyp</label><select class="form-select" name="type" required><option value="bank">Bankkonto</option><option value="savings">Rücklagenkonto</option><option value="credit_card">Kreditkarte</option><option value="paypal">PayPal</option><option value="cash">Bargeld</option><option value="clearing">Verrechnungskonto</option></select></div><div class="col-md-7"><label class="form-label" for="openingBalance">Anfangssaldo / Startkapital</label><div class="input-group"><input class="form-control" id="openingBalance" name="opening_balance" data-money="signed" value="0,00" placeholder="0,00" required><span class="input-group-text">EUR</span></div><div class="form-text">Auch negative Salden sind möglich, z. B. bei einer Kreditkarte.</div></div><div class="col-md-5"><label class="form-label">Währung</label><select class="form-select" name="currency"><option value="EUR">EUR – Euro</option><option value="USD">USD – US-Dollar</option><option value="GBP">GBP – Britisches Pfund</option><option value="CHF">CHF – Schweizer Franken</option></select></div><div class="col-12"><label class="form-label">Beschreibung <span class="text-secondary">(optional)</span></label><textarea class="form-control" name="description" rows="3" placeholder="z. B. Hauptkonto für geschäftliche Zahlungen"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Konto speichern</button></div></form></div></div>
<%- include('partials/foot') %>

<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><div class="eyebrow">Finanzen</div><h1>Standardbuchungen</h1><p class="text-secondary mb-0">Gehalt, Miete, Abos und andere wiederkehrende Beträge einmal speichern und jederzeit buchen.</p></div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recurringModal"><i class="bi bi-plus-lg me-1"></i>Standardbuchung anlegen</button>
</div>
<div class="row g-3">
  <% rows.forEach(r=>{ const labels={weekly:'Wöchentlich',monthly:'Monatlich',quarterly:'Vierteljährlich',yearly:'Jährlich'}; %>
  <div class="col-md-6 col-xl-4"><div class="card h-100 <%= r.active?'':'opacity-75' %>">
    <div class="card-body">
      <div class="d-flex justify-content-between gap-3 mb-3"><span class="badge text-bg-<%= r.type==='income'?'success':'danger' %>"><%= r.type==='income'?'Einnahme':'Ausgabe' %></span><strong class="fs-5 <%= r.type==='income'?'text-success':'text-danger' %>"><%= r.type==='income'?'+':'-' %><%= money(r.amount) %> €</strong></div>
      <h2 class="h5 mb-2"><%= r.description %></h2>
      <div class="small text-secondary"><i class="bi bi-arrow-repeat me-1"></i><%= labels[r.frequency]||r.frequency %></div>
      <div class="small text-secondary"><i class="bi bi-calendar-event me-1"></i>Nächster Termin: <%= new Date(r.next_date).toLocaleDateString('de-DE') %></div>
      <div class="small text-secondary"><i class="bi bi-bank me-1"></i><%= r.account||'Ohne Konto' %> · <%= r.category||'Ohne Kategorie' %></div>
      <% if(!r.active){ %><div class="mt-3 badge text-bg-secondary">Pausiert</div><% } %>
    </div>
    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
      <form method="post" action="/recurring/<%= r.id %>/book" onsubmit="this.querySelector('button').disabled=true"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-primary" <%= r.active?'':'disabled' %>><i class="bi bi-check2-circle me-1"></i>Jetzt buchen</button></form>
      <form method="post" action="/recurring/<%= r.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-secondary"><i class="bi bi-<%= r.active?'pause':'play' %>-circle me-1"></i><%= r.active?'Pausieren':'Aktivieren' %></button></form>
      <form method="post" action="/recurring/<%= r.id %>/delete" class="ms-auto" onsubmit="return confirm('Standardbuchung wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" title="Löschen"><i class="bi bi-trash"></i></button></form>
    </div>
  </div></div>
  <% }) %>
  <% if(!rows.length){ %><div class="col-12"><div class="card card-body text-center py-5 text-secondary"><i class="bi bi-arrow-repeat fs-1 mb-2"></i><p class="mb-3">Noch keine Standardbuchungen vorhanden.</p><div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recurringModal">Erste Standardbuchung anlegen</button></div></div></div><% } %>
</div>
<div class="modal fade" id="recurringModal"><div class="modal-dialog"><form method="post" action="/recurring" class="modal-content"><div class="modal-header"><h5>Standardbuchung anlegen</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="row g-3">
  <div class="col-md-6"><label class="form-label">Typ</label><select name="type" class="form-select"><option value="expense">Ausgabe</option><option value="income">Einnahme</option></select></div>
  <div class="col-md-6"><label class="form-label">Betrag</label><div class="input-group"><input name="amount" type="number" step="0.01" min="0.01" class="form-control" required><span class="input-group-text">€</span></div></div>
  <div class="col-12"><label class="form-label">Beschreibung</label><input name="description" class="form-control" placeholder="z. B. Gehalt oder Netflix" required></div>
  <div class="col-md-6"><label class="form-label">Intervall</label><select name="frequency" class="form-select"><option value="monthly">Monatlich</option><option value="weekly">Wöchentlich</option><option value="quarterly">Vierteljährlich</option><option value="yearly">Jährlich</option></select></div>
  <div class="col-md-6"><label class="form-label">Nächster Termin</label><input name="next_date" type="date" class="form-control" required></div>
  <div class="col-md-6"><label class="form-label">Konto</label><select name="account_id" class="form-select"><option value="">Ohne Konto</option><% accounts.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div>
  <div class="col-md-6"><label class="form-label">Kategorie</label><select name="category_id" class="form-select"><option value="">Ohne Kategorie</option><% categories.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div>
</div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Speichern</button></div></form></div></div>
<%- include('partials/foot') %>

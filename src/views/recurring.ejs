<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><div class="eyebrow">Finanzen</div><h1>Standardbuchungen</h1><p class="text-secondary mb-0">Gehalt, Miete, Abos und andere wiederkehrende Beträge einmal speichern und jederzeit buchen. Als Preisvorlage markiert, füllt der Betrag auch jede Buchung mit derselben Beschreibung vor.</p></div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recurringModal"><i class="bi bi-plus-lg me-1"></i>Standardbuchung anlegen</button>
</div>
<div class="row g-3">
  <% rows.forEach(r=>{ const labels={weekly:'Wöchentlich',monthly:'Monatlich',quarterly:'Vierteljährlich',yearly:'Jährlich'}; %>
  <div class="col-md-6 col-xl-4"><div class="card h-100 <%= r.active?'':'opacity-75' %>">
    <div class="card-body">
      <div class="d-flex justify-content-between gap-3 mb-3"><span class="badge text-bg-<%= r.type==='income'?'success':'danger' %>"><%= r.type==='income'?'Einnahme':'Ausgabe' %></span><strong class="fs-5 <%= r.type==='income'?'text-success':'text-danger' %>"><%= r.type==='income'?'+':'-' %><%= money(r.amount) %> €</strong></div>
      <h2 class="h5 mb-2"><%= r.description %></h2>
      <div class="small text-secondary"><i class="bi bi-arrow-repeat me-1"></i><%= labels[r.frequency]||r.frequency %></div>
      <div class="small text-secondary"><i class="bi bi-calendar-event me-1"></i>Nächster Termin: <%= new Date(r.next_date).toLocaleDateString('de-DE') %></div>
      <div class="small text-secondary"><i class="bi bi-bank me-1"></i><%= r.account||'Ohne Konto' %> · <%= r.category||'Ohne Kategorie' %></div>
      <div class="mt-3 d-flex flex-wrap gap-2">
        <% if(r.price_template){ %><span class="badge text-bg-primary" title="Dieser Betrag wird bei gleicher Beschreibung vorgeschlagen."><i class="bi bi-tag me-1"></i>Preisvorlage</span><% } %>
        <% if(!r.active){ %><span class="badge text-bg-secondary">Pausiert</span><% } %>
      </div>
    </div>
    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
      <form method="post" action="/recurring/<%= r.id %>/book" onsubmit="this.querySelector('button').disabled=true"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-primary" <%= r.active?'':'disabled' %>><i class="bi bi-check2-circle me-1"></i>Jetzt buchen</button></form>
      <button class="btn btn-sm btn-outline-secondary edit-recurring" data-bs-toggle="modal" data-bs-target="#recurringEditModal" data-id="<%= r.id %>" data-type="<%= r.type %>" data-description="<%= r.description %>" data-amount="<%= r.amount %>" data-frequency="<%= r.frequency %>" data-date="<%= r.next_date_input %>" data-account="<%= r.account_id||'' %>" data-account-name="<%= r.account||'' %>" data-category="<%= r.category_id||'' %>" data-category-name="<%= r.category||'' %>" data-template="<%= r.price_template?'true':'false' %>"><i class="bi bi-pencil me-1"></i>Bearbeiten</button>
      <form method="post" action="/recurring/<%= r.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-secondary"><i class="bi bi-<%= r.active?'pause':'play' %>-circle me-1"></i><%= r.active?'Pausieren':'Aktivieren' %></button></form>
      <form method="post" action="/recurring/<%= r.id %>/delete" class="ms-auto" onsubmit="return confirm('Standardbuchung wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" title="Löschen"><i class="bi bi-trash"></i></button></form>
    </div>
  </div></div>
  <% }) %>
  <% if(!rows.length){ %><div class="col-12"><div class="card card-body text-center py-5 text-secondary"><i class="bi bi-arrow-repeat fs-1 mb-2"></i><p class="mb-3">Noch keine Standardbuchungen vorhanden.</p><div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recurringModal">Erste Standardbuchung anlegen</button></div></div></div><% } %>
</div>
<div class="modal fade" id="recurringModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form method="post" action="/recurring" class="modal-content"><div class="modal-header"><h5>Standardbuchung anlegen</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('partials/recurring-fields',{idPrefix:'recurring',accounts,categories,mainAccountId}) %></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Speichern</button></div></form></div></div>
<div class="modal fade" id="recurringEditModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form method="post" class="modal-content" id="recurringEditForm"><div class="modal-header"><h5>Standardbuchung bearbeiten</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button></div><div class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('partials/recurring-fields',{idPrefix:'recurringEdit',accounts,categories,mainAccountId}) %></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-primary">Änderungen speichern</button></div></form></div></div>
<%- include('partials/description-suggestions') %>
<script src="/js/category-field.js"></script>
<script src="/js/description-category.js"></script>
<script src="/js/recurring.js"></script>
<%- include('partials/foot') %>
